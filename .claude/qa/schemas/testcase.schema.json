{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "testcase.schema.json",
  "title": "Canonical test case",
  "type": "object",
  "required": ["id", "title", "type", "appType", "module", "priority", "steps"],
  "properties": {
    "id": { "type": "string", "pattern": "^TC-[A-Z0-9]+-[0-9]{3,}$", "description": "TC-<MODULE>-<NNN>" },
    "title": { "type": "string", "minLength": 5 },
    "type": { "type": "string", "enum": ["functional", "integration", "regression", "smoke", "e2e"] },
    "appType": { "type": "string", "enum": ["web", "api"] },
    "module": { "type": "string", "description": "Module key from the pack's module-map.json" },
    "journey": { "type": "string", "description": "Journey key from the pack's journeys.md" },
    "priority": { "type": "string", "enum": ["P1", "P2", "P3", "P4"] },
    "tags": { "type": "array", "items": { "type": "string" } },
    "techniques": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["equivalence-partitioning", "boundary-value", "decision-table", "state-transition", "pairwise", "use-case", "error-guessing", "contract", "negative", "exploratory"]
      }
    },
    "requirement": {
      "type": "object",
      "description": "Traceability to the ADO requirement (User Story / PBI / Feature).",
      "properties": {
        "adoId": { "type": "integer" },
        "ref": { "type": "string", "description": "Any other reference (URL, doc section)." }
      }
    },
    "preconditions": { "type": "array", "items": { "type": "string" } },
    "data": { "type": "object", "description": "Named inputs. Reference secrets as ${ENV_VAR}." },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["action"],
        "properties": {
          "action": { "type": "string" },
          "expected": { "type": "string" }
        }
      }
    },
    "cleanup": { "type": "array", "items": { "type": "string" } },
    "automation": {
      "type": "object",
      "properties": {
        "status": { "type": "string", "enum": ["manual", "candidate", "automated", "not-automatable"] },
        "script": { "type": "string", "description": "Path to the automated test (file[:test name])." }
      }
    },
    "openQuestions": { "type": "array", "items": { "type": "string" } }
  }
}
