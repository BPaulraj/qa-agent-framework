{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "qa.config.schema.json",
  "title": "QA framework repo configuration (L3)",
  "type": "object",
  "required": [
    "version",
    "project",
    "appTypes",
    "environments",
    "defaultEnvironment"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "project": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "team": {
          "type": "string"
        }
      }
    },
    "appTypes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "web",
          "api"
        ]
      },
      "description": "Interfaces under test. Each maps to an adapter skill qa-adapter-<type>."
    },
    "packs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^pack-[a-z0-9-]+$"
      },
      "description": "Product/team packs in scope (folder names under .claude/skills/)."
    },
    "environments": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/definitions/environment"
      }
    },
    "defaultEnvironment": {
      "type": "string"
    },
    "automation": {
      "type": "object",
      "properties": {
        "web": {
          "$ref": "#/definitions/automationTarget"
        },
        "api": {
          "$ref": "#/definitions/automationTarget"
        },
        "apiSpecs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Paths or URLs to OpenAPI/Swagger/GraphQL schema files."
        },
        "runner": {
          "type": "object",
          "description": "Runner settings for catalog-based execution (any stack). Used by make-suite.mjs and parse-results.mjs. Defaults come from the stack drivers; override only what differs.",
          "properties": {
            "build": {
              "type": "string",
              "description": "Informational: maven | gradle | npm | pnpm | yarn | pytest | dotnet | other"
            },
            "command": {
              "type": "string",
              "description": "TestNG command template (Java). Placeholders: {pl}, {module}, {suiteXml}. Prefer commands.testng."
            },
            "cucumberCommand": {
              "type": "string",
              "description": "Template for Cucumber scenarios. Placeholders: {pl}, {module}, {features}."
            },
            "reports": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Report file globs (testng-results.xml, TEST-*.xml)."
            },
            "evidenceDirs": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Globs of files the framework writes on failure (screenshots, logs); matched by test method name."
            },
            "parallelModules": {
              "type": "integer",
              "description": "Max build modules to run in parallel (default 1)."
            },
            "commands": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "description": "Per-kind command templates overriding driver defaults. Keys: testng, junit, gradle, cucumber, cucumber-js, behave, playwright, jest, vitest, mocha, cypress, pytest, dotnet. Placeholders vary by kind: {cd} {pl} {module} {project} {suiteXml} {tests} {filters} {files} {regex} {locations} {specs} {nodeids} {filter} {logger} {features} {report}; {reportDir} is the run reports folder."
            }
          }
        }
      }
    },
    "execution": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "exploratory",
            "scripted",
            "both"
          ]
        },
        "headless": {
          "type": "boolean"
        }
      }
    },
    "paths": {
      "type": "object",
      "properties": {
        "cases": {
          "type": "string"
        },
        "runs": {
          "type": "string"
        },
        "plans": {
          "type": "string"
        }
      }
    },
    "ado": {
      "type": "object",
      "properties": {
        "organization": {
          "type": "string",
          "description": "e.g. https://dev.azure.com/contoso"
        },
        "project": {
          "type": "string"
        },
        "areaPath": {
          "type": "string"
        },
        "iterationPath": {
          "type": "string"
        },
        "testPlanId": {
          "type": [
            "integer",
            "null"
          ]
        },
        "testSuiteId": {
          "type": [
            "integer",
            "null"
          ]
        },
        "patEnvVar": {
          "type": "string",
          "description": "Env var holding the PAT. Default AZURE_DEVOPS_EXT_PAT."
        },
        "bugDefaults": {
          "type": "object",
          "properties": {
            "tags": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "assignedTo": {
              "type": "string"
            }
          }
        }
      }
    },
    "guardrails": {
      "type": "object",
      "properties": {
        "blockedHosts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Host globs never to contact, e.g. *.prod.contoso.com"
        }
      }
    },
    "regression": {
      "type": "object",
      "properties": {
        "baseBranch": {
          "type": "string"
        },
        "alwaysInclude": {
          "type": "object",
          "properties": {
            "tags": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "priorities": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "P1",
                  "P2",
                  "P3",
                  "P4"
                ]
              }
            }
          }
        },
        "maxDepth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5,
          "description": "dependsOn hops to follow (default 1)."
        }
      }
    },
    "repoType": {
      "type": "string",
      "enum": [
        "app-and-tests",
        "tests-only"
      ],
      "description": "tests-only = automation repo whose application code lives elsewhere; regression is driven by ADO items / app repo PRs."
    },
    "appRepos": {
      "type": "array",
      "description": "Application repositories whose changes drive regression in a tests-only repo.",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "adoRepo": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  },
  "definitions": {
    "environment": {
      "type": "object",
      "properties": {
        "webBaseUrl": {
          "type": "string"
        },
        "apiBaseUrl": {
          "type": "string"
        },
        "allowWrite": {
          "type": "boolean",
          "description": "Default true. False = read-only testing."
        },
        "blocked": {
          "type": "boolean",
          "description": "True = never contact (e.g. production)."
        },
        "auth": {
          "type": "object",
          "description": "Names of env vars holding credentials, never the values.",
          "additionalProperties": {
            "type": "string"
          }
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "automationTarget": {
      "type": "object",
      "properties": {
        "framework": {
          "type": "string",
          "description": "playwright | cypress | selenium | webdriverio | restassured | supertest | pytest | karate | postman | none | ..."
        },
        "language": {
          "type": "string"
        },
        "testDir": {
          "type": "string"
        },
        "runCommand": {
          "type": "string",
          "description": "Command to run tests; {files} and {grep} placeholders allowed."
        },
        "conventions": {
          "type": "string",
          "description": "Free text: page objects, fixtures, naming, where helpers live."
        }
      }
    }
  }
}
